#!/bin/sh
# Server-side guard for Kai: never push to main/master, never delete remote branches.
# Any other branch (kai/..., feat/..., fix/...) is allowed. Installed with:
#   git config --global core.hooksPath ~/agent-team/deploy/git-hooks
while read local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"
  case "$branch" in
    main|master) echo "pre-push: blocked push to $branch (open a pull request instead)" >&2; exit 1 ;;
  esac
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    echo "pre-push: blocked deleting $branch" >&2; exit 1
  fi
done
exit 0
