{
  "name": "agent-team",
  "version": "1.0.0",
  "private": true,
  "description": "A team of AI agents (Claude Agent SDK) you message on Slack and Telegram: they route work, collaborate, hand off tasks, run daily routines and ask for approval before acting.",
  "author": "Kelvin Osei Boateng",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "claude",
    "agent-sdk",
    "slack-bot",
    "telegram-bot",
    "multi-agent",
    "automation",
    "human-in-the-loop"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/bot.js",
    "worker": "node src/worker.js",
    "dev": "node --watch src/bot.js",
    "test": "node --test --experimental-test-module-mocks --test-concurrency=1 'test/**/*.test.js'",
    "check": "node scripts/check.js",
    "redis": "docker compose up -d redis",
    "auth:google": "node scripts/auth-google.js",
    "auth:microsoft": "node scripts/auth-microsoft.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@anthropic-ai/sdk": "^0.133.0",
    "@slack/bolt": "^5.1.0",
    "@slack/web-api": "^8.2.0",
    "bullmq": "^6.3.12",
    "dotenv": "^18.0.7",
    "exceljs": "^4.4.0",
    "grammy": "^1.45.1",
    "ioredis": "^6.0.0",
    "mammoth": "^1.12.0",
    "zod": "^4.0.0"
  }
}
