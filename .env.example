# --- Who the team works for (used in every prompt) ---
OWNER_NAME=Kelvin
OWNER_BIO=MSc Cybersecurity student in Berlin, full-stack and React Native developer, building in public.

# ============ Chat apps: fill in Slack, Telegram, or both ============

# --- Slack (from api.slack.com/apps) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...        # Socket Mode token, scope: connections:write
SLACK_SIGNING_SECRET=...

# Only this Slack user can give orders (your member ID, e.g. U0123ABCD)
OWNER_SLACK_ID=U...

# --- Telegram (one bot per teammate, from @BotFather) ---
# Your numeric Telegram user id (message @userinfobot to get it)
TELEGRAM_OWNER_ID=
TELEGRAM_TOKEN_KAI=
TELEGRAM_TOKEN_NOVA=
TELEGRAM_TOKEN_REMY=
TELEGRAM_TOKEN_IRIS=
# The bot that reads group messages (privacy mode must be OFF for it in @BotFather)
TELEGRAM_LEAD=Remy
# Errors are DM'd to you by the lead bot; set to false to turn off
TELEGRAM_ALERTS=true

# --- Email & calendar for Iris (see README) ---
# Google: OAuth client of type "Desktop app"; then run `npm run auth:google`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Microsoft (personal outlook.com account): app registration client id; then run `npm run auth:microsoft`
MS_CLIENT_ID=
MS_REFRESH_TOKEN=

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ROUTER_MODEL=claude-haiku-5-5
AGENT_MODEL=claude-sonnet-5-5

# --- Cost control ---
# Team pauses for the day once this is spent (USD, 0 = no limit). Resets at midnight in BUDGET_TZ.
DAILY_BUDGET_USD=3
BUDGET_TZ=Europe/Berlin
# Per-teammate model (defaults: Kai + Nova on Sonnet, Remy on Haiku)
# MODEL_CODE=claude-sonnet-5-5
# MODEL_RESEARCH=claude-sonnet-5-5
# MODEL_WRITER=claude-haiku-5-5
# MODEL_ASSISTANT=claude-sonnet-5-5
# Max spend for a single task before the teammate stops and asks (defaults 0.75 / 0.30 / 0.05)
# MAX_USD_CODE=0.75
# MAX_USD_RESEARCH=0.30
# MAX_USD_WRITER=0.05
# MAX_USD_ASSISTANT=0.25
# How many teammates can work at the same time
CONCURRENCY=3

# --- Infra ---
# Optional. Leave empty to use the built-in queue (no Redis needed).
REDIS_URL=

# Where the code agent is allowed to work (clone your repos in here)
WORKSPACE_DIR=./workspace

# --- Logging ---
# debug also logs every tool an agent uses
LOG_LEVEL=info
# pretty (human) or json (machine)
LOG_FORMAT=pretty
# Optional: Slack channel (name or ID) that gets a 🚨 message on every error
LOG_CHANNEL=agent-logs
